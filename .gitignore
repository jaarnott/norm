# Terraform
# Recursive: dev-vm/ is a second root module with its own .terraform (~99 MB of
# provider binary). The non-recursive patterns only covered infra/terraform/
# itself, so a new module directory would have committed the lot.
infra/terraform/**/.terraform/
# tfplan* not tfplan: saved plans get numbered (tfplan2, tfplan3) when you
# re-plan, and a plan file embeds the fully resolved config.
infra/terraform/**/*.tfplan*
infra/terraform/**/tfplan*
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/.terraform.lock.hcl
# Real tfvars carry project ids and personal emails; the .example does not.
infra/terraform/**/terraform.tfvars

# Claude Code local settings (per-developer permissions)
.claude/settings.local.json

# Playwright MCP artifacts (local session screenshots, console logs)
.playwright-mcp/

# E2E test artifacts and runtime-generated specs
apps/e2e/results/
apps/e2e/tests/

# Ad-hoc screenshots (should not be committed)
/*.png

# Local credentials — never commit. `pat` holds a GitHub Personal Access Token
# used to read the loadedreports/timeclock-v2 reference implementation.
# `.local/` holds LoadedHub login credentials for browser sessions and
# the opt-in LoadedHub integration tests.
/pat
/pat.txt
*.pat
/.local/
.env
.env.local
